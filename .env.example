# Copie para .env.local (ignorado pelo Git) e ajuste. Nada aqui é segredo real: são credenciais
# de desenvolvimento local. Nunca coloque credenciais de produção neste arquivo.

# Banco usado pelo app e pelas migrações (npm run db:migrate).
DATABASE_URL=postgresql://archives:archives_dev@127.0.0.1:5433/archives_vi_dev

# Servidor PostgreSQL usado pelos testes. O papel precisa poder criar bancos (CREATEDB).
# Cada suíte cria um banco descartável, aplica as migrações e o apaga no fim.
TEST_DATABASE_URL=postgresql://archives:archives_dev@127.0.0.1:5433/postgres
